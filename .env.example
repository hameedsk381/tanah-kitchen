# Tanah Kitchen & Bar Server Configuration

PORT=5000

# Local MongoDB or MongoDB Atlas connection string
# Examples:
# Local: mongodb://localhost:27017/tanah_kitchen
# Docker: mongodb://mongo:27017/tanah_kitchen
# MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@cluster0.mongodb.net/tanah_kitchen?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/tanah_kitchen
