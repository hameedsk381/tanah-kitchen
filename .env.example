# Tanah Kitchen & Bar Server Configuration

PORT=5000

# External MongoDB Connection String (MongoDB Atlas / Cloud / Managed MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/tanah_kitchen?retryWrites=true&w=majority

# Admin Account Credentials (Set your secure admin password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_EMAIL=admin@tanahkitchen.com

# Secret used to sign admin JWTs (required in production, min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# JWT_EXPIRES_IN=12h

# Seed default menu/bento/gallery into empty collections on startup (default true)
# SEED_ON_STARTUP=true

# Weekly MongoDB backup to Google Cloud Storage (enabled when GCS_BACKUP_BUCKET is set).
# Uses the same GCP_* credentials as media uploads. Use a PRIVATE bucket, separate from the
# public media bucket. The service account needs Storage Object Admin (or create/view/list) on it.
# GCS_BACKUP_BUCKET=
# GCS_BACKUP_PREFIX=tanah-kitchen/
# BACKUP_CRON=0 3 * * 0

# Reverse proxies in front of the API (used for per-IP rate limiting). Default 1.
# TRUST_PROXY=1

# Google Cloud Storage (GCS) Configuration
# Option 1: Direct Credentials
GCP_PROJECT_ID=tanah-kitchen-prod
GCP_STORAGE_BUCKET=tanah-kitchen-media
GCP_CLIENT_EMAIL=tanah-storage@tanah-kitchen-prod.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 2: Service Account Key File (Alternative)
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# Option 3: Custom CDN URL Prefix (Optional)
# GCP_PUBLIC_URL_PREFIX=https://media.tanahkitchen.com
